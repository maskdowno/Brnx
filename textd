-- [[ PERSISTENT TOGGLE BUILDER ]] --
local function CreateToggle(name, parent, func)
    local b = Instance.new("TextButton", parent)
    b.Size, b.Font, b.TextSize = UDim2.new(1,0,0,38), Enum.Font.GothamMedium, 14
    Instance.new("UICorner", b)
    
    local function refreshUI()
        local isOn = toggleMemory[name] or false
        b.BackgroundColor3 = isOn and Color3.fromRGB(50, 200, 100) or Color3.fromRGB(200, 50, 50)
        b.Text = name .. (isOn and " [ON]" or " [OFF]")
    end
    
    refreshUI()
    b.MouseButton1Click:Connect(function()
        if not currentText then return end
        toggleMemory[name] = not (toggleMemory[name] or false)
        refreshUI()
        func(toggleMemory[name], currentText)
    end)
end

-- [[ REFRESH LAYER LIST ]] --
local function RefreshList()
    for _, v in pairs(ListS:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, layer in pairs(GlobalStorage:GetChildren()) do
        local lb = Instance.new("TextButton", ListS)
        lb.Size, lb.Text, lb.BackgroundColor3 = UDim2.new(1,0,0,30), layer.Text, Color3.fromRGB(40,40,45)
        lb.TextColor3, lb.Font = Color3.new(1,1,1), Enum.Font.Gotham; Instance.new("UICorner", lb)
        lb.MouseButton1Click:Connect(function() currentText = layer; topZ = topZ + 1; layer.ZIndex = topZ end)
    end
end

