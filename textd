CreateToggle("Typewriter", MainS, function(on, o)
    activeEffects[o] = activeEffects[o] or {}; activeEffects[o].Typing = on
    task.spawn(function()
        while o and activeEffects[o].Typing do
            local full = o.Text; o.Text = ""
            for i=1, #full do if not activeEffects[o].Typing then break end o.Text = full:sub(1,i) task.wait(0.07) end
            task.wait(1.5)
        end
    end)
end)

