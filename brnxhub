-- NOTIFICATIONS
local NotifyFolder = Instance.new("Folder")
NotifyFolder.Name = "Notifications"
NotifyFolder.Parent = ScreenGui

local function CreateNotification(title, content, duration)
	local Noti = Instance.new("Frame")
	Noti.Size = UDim2.new(0,300,0,80)
	Noti.Position = UDim2.new(0.5,-150,0.1,0)
	Noti.BackgroundColor3 = Color3.fromRGB(0,0,0)
	Noti.BorderSizePixel = 0
	Noti.Parent = NotifyFolder
	Noti.ClipsDescendants = true
	Noti.AnchorPoint = Vector2.new(0.5,0)

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(255,255,255)
	Stroke.Thickness = 2
	Stroke.Parent = Noti

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.Size = UDim2.new(1,-10,0,25)
	TitleLabel.Position = UDim2.new(0,5,0,5)
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Text = title:upper()
	TitleLabel.Font = Enum.Font.GothamBold
	TitleLabel.TextColor3 = Color3.fromRGB(255,255,255)
	TitleLabel.TextScaled = false
	TitleLabel.TextSize = 16
	TitleLabel.Parent = Noti

	local ContentLabel = Instance.new("TextLabel")
	ContentLabel.Size = UDim2.new(1,-10,0,40)
	ContentLabel.Position = UDim2.new(0,5,0,30)
	ContentLabel.BackgroundTransparency = 1
	ContentLabel.Text = content
	ContentLabel.Font = Enum.Font.Gotham
	ContentLabel.TextColor3 = Color3.fromRGB(255,255,255)
	ContentLabel.TextSize = 14
	ContentLabel.TextWrapped = true
	ContentLabel.Parent = Noti

	-- Fade-in
	Noti.BackgroundTransparency = 1
	Stroke.Transparency = 1
	TweenService:Create(Noti, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
	TweenService:Create(Stroke, TweenInfo.new(0.3), {Transparency = 0}):Play()

	-- Auto fade-out
	task.spawn(function()
		task.wait(duration)
		local fade = TweenService:Create(Noti, TweenInfo.new(0.4), {BackgroundTransparency = 1})
		fade:Play()
		fade.Completed:Wait()
		Noti:Destroy()
	end)
end

