-- BUTTON HOVER ANIMATION
local function AddHover(button)
	local Glow = Instance.new("UIStroke")
	Glow.Color = Color3.fromRGB(255,255,255)
	Glow.Thickness = 1
	Glow.Parent = button

	button.MouseEnter:Connect(function()
		TweenService:Create(Glow, TweenInfo.new(0.3), {Thickness = 4}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(Glow, TweenInfo.new(0.3), {Thickness = 1}):Play()
	end)
end

AddHover(Submit)
AddHover(CopyKey)
AddHover(CloseBtn)