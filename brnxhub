local player = Players.LocalPlayer

-- GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BRNX_UI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = player:WaitForChild("PlayerGui")

-- Rain Layer
local RainFolder = Instance.new("Folder")
RainFolder.Name = "Rain"
RainFolder.Parent = ScreenGui

for i = 1, 50 do
    local Drop = Instance.new("Frame")
    Drop.Size = UDim2.new(0,2,0,20)
    Drop.Position = UDim2.new(math.random(),0,math.random(-1,0),0)
    Drop.BackgroundColor3 = Color3.new(1,1,1)
    Drop.BackgroundTransparency = 0.8
    Drop.BorderSizePixel = 0
    Drop.Parent = RainFolder

    task.spawn(function()
        while true do
            Drop.Position = UDim2.new(math.random(),0,-0.2,0)
            TweenService:Create(Drop, TweenInfo.new(1.5), {Position = UDim2.new(Drop.Position.X.Scale,0,1.2,0)}):Play()
            task.wait(1.5)
        end
    end)
end

