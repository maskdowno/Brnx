local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

-- Window
local Window = Rayfield:CreateWindow({
    Name = "TNB Premium Access",
    LoadingTitle = "TNB Premium",
    LoadingSubtitle = "Secure Key System",
    ConfigurationSaving = {
        Enabled = false
    },
    Discord = {
        Enabled = false
    },
    KeySystem = false
})

-- Tab
local KeyTab = Window:CreateTab("🔐 Key System", 4483362458)

KeyTab:CreateSection("Authentication")

local enteredKey = ""

KeyTab:CreateInput({
    Name = "Enter Your Key",
    PlaceholderText = "Type your key here...",
    RemoveTextAfterFocusLost = false,
    Callback = function(text)
        enteredKey = text
    end
})

KeyTab:CreateButton({
    Name = "Copy Key Link",
    Callback = function()
        setclipboard("https://work.ink/1Zdz/tnbbyvermin")
        Rayfield:Notify({
            Title = "Link Copied",
            Content = "Key link copied to clipboard.",
            Duration = 3,
            Image = 4483362458
        })
    end
})

KeyTab:CreateButton({
    Name = "Submit Key",
    Callback = function()

        if enteredKey == nil or enteredKey == "" then
            Rayfield:Notify({
                Title = "Error",
                Content = "Enter a key first.",
                Duration = 4,
                Image = 4483362458
            })
            return
        end

        if enteredKey == "Bronx1284732" then
            Rayfield:Notify({
                Title = "Access Granted",
                Content = "Key accepted. Loading script...",
                Duration = 3,
                Image = 4483362458
            })

            task.wait(1)

            Rayfield:Destroy()

            loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/89hbuy2f3bh872d/34rt245yhwerthgertg/refs/heads/main/TN-BY"
            ))()

        else
            Rayfield:Notify({
                Title = "Invalid Key",
                Content = "The key you entered is incorrect.",
                Duration = 5,
                Image = 4483362458
            })
        end
    end
})

KeyTab:CreateLabel("TNB Premium Scripts")
KeyTab:CreateLabel("Status: Secure")