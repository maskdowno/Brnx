-- 1. LOAD FLUENT LIBRARY
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- 2. SOUND EFFECT
local function playLoadSound()
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://6042049033" 
    sound.Volume = 0.5
    sound.Parent = game:GetService("SoundService")
    sound:Play()
    game:GetService("Debris"):AddItem(sound, 2)
end
playLoadSound()

-- 3. WINDOW SETUP
local Window = Fluent:CreateWindow({
    Title = "TNB Key System",
    SubTitle = "by Vermin",
    TabWidth = 160,
    Size = UDim2.fromOffset(440, 320),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "Access", Icon = "unlock" })
}

local enteredKey = ""

-- INPUT BOX
Tabs.Main:AddInput("Input", {
    Title = "Enter Key",
    Placeholder = "Paste key here...",
    Callback = function(Value)
        enteredKey = Value
    end
})

-- GET KEY BUTTON
Tabs.Main:AddButton({
    Title = "Get Key",
    Callback = function()
        setclipboard("https://work.ink")
        Fluent:Notify({ Title = "Copied", Content = "Link added to clipboard!", Duration = 3 })
    end
})

-- SUBMIT BUTTON (The only place the script should load from)
Tabs.Main:AddButton({
    Title = "Submit",
    Callback = function()
        -- Hardcoded "Admin" bypass
        if enteredKey == "Bronx" then
            Window:Destroy()
            loadstring(game:HttpGet("https://raw.githubusercontent.com"))()
            return
        end

        -- API Check
        local success, verifyResponse = pcall(function()
            return game:HttpGet("https://work.ink" .. enteredKey)
        end)

        if success then
            local keyInfo = game:GetService("HttpService"):JSONDecode(verifyResponse)
            if keyInfo and keyInfo.valid == true and keyInfo.info and keyInfo.info.linkId == 805765 then
                Window:Destroy()
                loadstring(game:HttpGet("https://raw.githubusercontent.com"))()
            else
                Fluent:Notify({ Title = "Invalid", Content = "Incorrect key.", Duration = 4 })
            end
        else
            Fluent:Notify({ Title = "Error", Content = "Connection failed.", Duration = 4 })
        end
    end
})

Window:SelectTab(1)
