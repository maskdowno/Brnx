-- Eye Flash
task.spawn(function()
	while true do
		local fadeOut = TweenService:Create(Eye, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {ImageTransparency = 1})
		local fadeIn = TweenService:Create(Eye, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {ImageTransparency = 0})
		fadeOut:Play()
		fadeOut.Completed:Wait()
		fadeIn:Play()
		fadeIn.Completed:Wait()
	end
end)

