-- [[ PHONE UI ]] --
local Phone = Instance.new("Frame", ScreenGui)
Phone.Size, Phone.Position, Phone.BackgroundColor3 = UDim2.new(0,300,0,580), UDim2.new(0.5,-150,0.5,-290), Color3.fromRGB(8,8,10)
