-- [[ PERSISTENT TOGGLE SYSTEM ]] --
local function Action(name, parent, color, func)
    local b = Instance.new("TextButton", parent); b.Size, b.Text, b.BackgroundColor3 = UDim2.new(1,0,0,38), name, color
    b.TextColor3, b.Font = Color3.new(1,1,1), Enum.Font.GothamBold; Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(function() if currentText then func(currentText) end end)
end

local function Toggle(name, parent, func)
    local b = Instance.new("TextButton", parent)
    b.Size, b.TextColor3, b.Font = UDim2.new(1,0,0,38), Color3.new(1,1,1), Enum.Font.GothamMedium
    Instance.new("UICorner", b)

    -- Refresh display based on saved state
    local function updateDisplay()
        local state = toggleStates[name] or false
        b.BackgroundColor3 = state and Color3.fromRGB(50, 200, 100) or Color3.fromRGB(200, 50, 50)
        b.Text = name .. (state and " [ON]" or " [OFF]")
    end
    
    updateDisplay()

    b.MouseButton1Click:Connect(function()
        if not currentText then return end
        toggleStates[name] = not (toggleStates[name] or false)
        updateDisplay()
        func(toggleStates[name], currentText)
    end)
end

-- [[ REFRESH LAYER LIST ]] --
local function RefreshList()
    for _, v in pairs(ListS:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, layer in pairs(GlobalStorage:GetChildren()) do
        local lb = Instance.new("TextButton", ListS)
        lb.Size, lb.Text, lb.BackgroundColor3 = UDim2.new(1,0,0,30), "Layer: "..layer.Text, Color3.fromRGB(40,40,45)
        lb.TextColor3, lb.Font = Color3.new(1,1,1), Enum.Font.Gotham; Instance.new("UICorner", lb)
        lb.MouseButton1Click:Connect(function() currentText = layer; topZ = topZ + 1; layer.ZIndex = topZ end)
    end
end

