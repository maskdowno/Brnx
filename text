local function EditBox(parent, placeholder, func)
    local eb = Instance.new("TextBox", parent); eb.Size, eb.BackgroundColor3, eb.TextColor3 = UDim2.new(1,0,0,35), Color3.fromRGB(25,25,30), Color3.new(1,1,1)
