-- [[ THE FX ENGINE ]] --
local function AddFX(name, func)
    local b = Instance.new("TextButton", FXS); b.Size, b.BackgroundColor3 = UDim2.new(1,0,0,35), Color3.fromRGB(30,30,35)
    b.TextColor3, b.Font, b.TextSize = Color3.new(1,1,1), Enum.Font.GothamMedium, 13; Instance.new("UICorner", b)
    RunService.RenderStepped:Connect(function()
        local on = (currentText and activeEffects[currentText] and activeEffects[currentText][name])
        b.BackgroundColor3 = on and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(40,40,45)
        b.Text = name .. (on and " [ON]" or " [OFF]")
    end)
    b.MouseButton1Click:Connect(function()
        if not currentText then return end
        activeEffects[currentText] = activeEffects[currentText] or {}
        activeEffects[currentText][name] = not activeEffects[currentText][name]
        func(activeEffects[currentText][name], currentText)
    end)
end

AddFX("Rainbow", function(on, o) task.spawn(function() while o and activeEffects[o].Rainbow do o.TextColor3 = Color3.fromHSV(tick()%5/5, 0.8, 1) task.wait() end end) end)
AddFX("Beat Jump", function(on, o) local sY = o.Position.Y.Offset; task.spawn(function() while o and activeEffects[o]["Beat Jump"] do TS:Create(o, TweenInfo.new(0.2), {Position = UDim2.new(o.Position.X.Scale, o.Position.X.Offset, o.Position.Y.Scale, sY-40)}):Play(); task.wait(0.2); TS:Create(o, TweenInfo.new(0.2), {Position = UDim2.new(o.Position.X.Scale, o.Position.X.Offset, o.Position.Y.Scale, sY)}):Play(); task.wait(0.6) end end) end)
AddFX("Glitch", function(on, o) task.spawn(function() while o and activeEffects[o].Glitch do o.Position = o.Position + UDim2.new(0,math.random(-5,5),0,math.random(-5,5)); task.wait(0.05) end end) end)
AddFX("Neon Pulse", function(on, o) local s = o:FindFirstChild("UIStroke") or Instance.new("UIStroke", o); task.spawn(function() while o and activeEffects[o]["Neon Pulse"] do s.Enabled = true; s.Transparency = (math.sin(tick()*5)+1)/2; task.wait() end s.Enabled = false end) end)

