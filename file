-- [[ TOGGLE ENGINE ]] --
local function AddFX(name, parent, func)
    local b = Instance.new("TextButton", parent); b.Size, b.Font, b.TextSize = UDim2.new(1,0,0,35), Enum.Font.GothamMedium, 13; Instance.new("UICorner", b)
    RunService.RenderStepped:Connect(function()
        local isOn = (currentText and activeEffects[currentText] and activeEffects[currentText][name])
        b.BackgroundColor3 = isOn and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(40,40,45)
        b.Text = name .. (isOn and " [ON]" or " [OFF]")
    end)
    b.MouseButton1Click:Connect(function()
        if not currentText then return end
        activeEffects[currentText] = activeEffects[currentText] or {}
        activeEffects[currentText][name] = not activeEffects[currentText][name]
        func(activeEffects[currentText][name], currentText)
    end)
end

-- [[ THE 15+ EFFECTS ]] --
AddFX("Glitch", FXS, function(on, o)
    task.spawn(function() while o and activeEffects[o].Glitch do 
        o.Position = o.Position + UDim2.new(0, math.random(-5,5), 0, math.random(-5,5))
        o.TextTransparency = math.random(0,3)/10; task.wait(0.05) 
    end o.TextTransparency = 0 end)
end)

AddFX("Wave", FXS, function(on, o)
    local startY = o.Position.Y.Offset
    task.spawn(function() while o and activeEffects[o].Wave do 
        o.Position = UDim2.new(o.Position.X.Scale, o.Position.X.Offset, o.Position.Y.Scale, startY + math.sin(tick()*5)*20)
        task.wait() 
    end end)
end)

AddFX("Ghosting", FXS, function(on, o)
    task.spawn(function() while o and activeEffects[o].Ghosting do 
        local clone = o:Clone(); clone.Parent = o.Parent; clone.ZIndex = o.ZIndex - 1
        TS:Create(clone, TweenInfo.new(0.5), {TextTransparency = 1, Size = o.Size + UDim2.new(0,50,0,50)}):Play()
        task.wait(0.2); game:GetService("Debris"):AddItem(clone, 0.5)
    end end)
end)

AddFX("Rotation", FXS, function(on, o)
    task.spawn(function() while o and activeEffects[o].Rotation do o.Rotation = o.Rotation + 5; task.wait() end o.Rotation = 0 end)
end)

AddFX("Breathing", FXS, function(on, o)
    task.spawn(function() while o and activeEffects[o].Breathing do 
        TS:Create(o, TweenInfo.new(1), {TextSize = o.TextSize + 15}):Play(); task.wait(1)
        TS:Create(o, TweenInfo.new(1), {TextSize = o.TextSize - 15}):Play(); task.wait(1)
    end end)
end)

AddFX("Rainbow", FXS, function(on, o)
    task.spawn(function() while o and activeEffects[o].Rainbow do o.TextColor3 = Color3.fromHSV(tick()%5/5, 0.8, 1) task.wait() end end)
end)

AddFX("Strobe", FXS, function(on, o)
    task.spawn(function() while o and activeEffects[o].Strobe do o.Visible = not o.Visible; task.wait(0.1) end o.Visible = true end)
end)

AddFX("Shake", FXS, function(on, o)
    task.spawn(function() while o and activeEffects[o].Shake do 
